{
  "manifest_version": 3,
  "name": "Multi-Platform Audio Compressor",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "Audio Compressor Settings",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/16.png",
      "24": "assets/icons/24.png",
      "32": "assets/icons/32.png",
      "48": "assets/icons/48.png",
      "64": "assets/icons/64.png",
      "128": "assets/icons/128.png",
      "256": "assets/icons/256.png",
      "512": "assets/icons/512.png"
    }
  },
  "background": {
    "service_worker": "scripts/background.ts"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtu.be/*",
        "https://www.twitch.tv/*",
        "https://clips.twitch.tv/*",
        "https://www.bilibili.com/*",
        "https://live.bilibili.com/*"
      ],
      "js": ["scripts/content-script.ts"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "assets/icons/16.png",
    "24": "assets/icons/24.png",
    "32": "assets/icons/32.png",
    "48": "assets/icons/48.png",
    "64": "assets/icons/64.png",
    "128": "assets/icons/128.png",
    "256": "assets/icons/256.png",
    "512": "assets/icons/512.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icons/16-off.png",
        "assets/icons/24-off.png",
        "assets/icons/32-off.png",
        "assets/icons/48-off.png",
        "assets/icons/64-off.png",
        "assets/icons/128-off.png",
        "assets/icons/256-off.png",
        "assets/icons/512-off.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "youtubeaudiocompressor@dancodes.online"
    }
  }
}
